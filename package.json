{
  "name": "opulent-sponsor-context-showcase",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "research": "node skills/opulent-sponsor-context-showcase/scripts/research.mjs",
    "deliver": "node skills/opulent-sponsor-context-showcase/scripts/deliver.mjs",
    "discover": "node skills/opulent-sponsor-context-showcase/scripts/discover_sponsors.mjs",
    "dashboard": "npm --prefix dashboard run build",
    "dashboard:serve": "npm --prefix dashboard run start",
    "test": "node --test tests/*.test.mjs",
    "targets": "node skills/opulent-sponsor-context-showcase/scripts/load_targets.mjs --out artifacts/cohort.json",
    "calls": "node skills/opulent-sponsor-context-showcase/scripts/run_calls.mjs",
    "signal": "node skills/opulent-sponsor-context-showcase/scripts/scrape_signal.mjs",
    "brand": "node skills/opulent-sponsor-context-showcase/scripts/extract_brand.mjs",
    "assemble": "node skills/opulent-sponsor-context-showcase/scripts/assemble.mjs",
    "email": "node skills/opulent-sponsor-context-showcase/scripts/render_email.mjs && node skills/opulent-sponsor-context-showcase/scripts/lint_pitch.mjs",
    "validate": "node skills/opulent-sponsor-context-showcase/scripts/validate_packet.mjs artifacts/packet.json",
    "lint:pitch": "node skills/opulent-sponsor-context-showcase/scripts/lint_pitch.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
